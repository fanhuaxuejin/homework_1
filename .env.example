# 【必填】LLM API Key
# DeepSeek 平台： https://platform.deepseek.com/api_keys
LLM_API_KEY=sk-请替换为你的真实Key

# 【可选】指定生效的 provider，取值见 config.py 中 PROVIDERS 的键
# 不填则默认 deepseek
LLM_PROVIDER=deepseek

# 【可选】覆盖模型名。留空则使用 provider 的默认模型。
# DeepSeek 当前可用： deepseek-flash（快/便宜）、deepseek-v4-pro（更强）
# 注意：deepseek-chat / deepseek-reasoner 已下线，不要再用
LLM_MODEL=

# 【可选】思考模式开关（DeepSeek V4 系列默认开启）
# 代码解释任务建议开启，推理质量更好；追求速度/省钱可设为 0
LLM_THINKING=1

# 【可选】单次 LLM 调用超时（秒）与最大重试次数
LLM_TIMEOUT=120
LLM_MAX_RETRIES=4

# 【可选】允许 Agent 读取的根目录，默认当前工作目录
# AGENT_WORKSPACE=.

# 【可选】run_python 工具执行代码的超时（秒）
RUN_PYTHON_TIMEOUT=10
